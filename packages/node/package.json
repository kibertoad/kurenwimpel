{
  "name": "@kurenwimpel/node",
  "version": "0.0.0",
  "description": "Node.js service wrapper for kurenwimpel feature flags.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/kurenwimpel.git",
    "directory": "packages/node"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./opentelemetry": {
      "types": "./dist/opentelemetry.d.ts",
      "default": "./dist/opentelemetry.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kurenwimpel/core": "workspace:^"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
