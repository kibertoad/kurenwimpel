{
  "name": "@kurenwimpel/cloudflare",
  "version": "0.0.0",
  "description": "Cloudflare Workers service wrapper for kurenwimpel feature flags.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/kurenwimpel.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kv-layout": {
      "types": "./dist/kv-layout.d.ts",
      "default": "./dist/kv-layout.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kurenwimpel/core": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
