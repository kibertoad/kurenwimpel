{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  // Workers runtime types come from `pnpm run cf-typegen`, which supersedes
  // @cloudflare/workers-types and stays in sync with wrangler.toml.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
