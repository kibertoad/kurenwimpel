{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Test-only types must not leak into the published declarations.
    "types": []
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"],
  "references": [{ "path": "../core/tsconfig.build.json" }]
}
