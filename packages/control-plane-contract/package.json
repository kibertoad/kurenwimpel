{
  "name": "@kurenwimpel/control-plane-contract",
  "version": "0.0.0",
  "private": true,
  "description": "The kurenwimpel control plane HTTP API, as Standard Schema definitions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/kurenwimpel.git",
    "directory": "packages/control-plane-contract"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@toad-contracts/core": "^0.4.0",
    "@toad-contracts/zod": "^0.2.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
