{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // The handler runs on Workers, Node and Bun, so the source sees only the Fetch API.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../ofrep/tsconfig.build.json" }
  ]
}
