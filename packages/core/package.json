{
  "name": "@kurenwimpel/core",
  "version": "0.0.0",
  "description": "Runtime-agnostic feature flag evaluation engine. Zero dependencies, no platform APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/kurenwimpel.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "schema",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ruleset.schema.json": "./schema/ruleset.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
