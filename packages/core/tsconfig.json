{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // No ambient platform types at all. Core must not reach for a Node or DOM
    // global, and this is what stops one slipping in unnoticed.
    "types": []
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
