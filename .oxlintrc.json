{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "promise", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn",
    "style": "off"
  },
  "env": {
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/worker-configuration.d.ts"
  ],
  "rules": {
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/explicit-module-boundary-types": "off",
    "import/no-cycle": "error",
    "import/extensions": ["error", "ignorePackages"],
    "unicorn/no-null": "off",
    // `export const X = {...} as const; export type X = ...` is the enum-free
    // idiom this repo uses; TypeScript already rejects genuine redeclarations.
    "no-redeclare": "off",
    // Size budgets. Blank lines and comments do not count toward them, so
    // documenting a function is never what pushes it over.
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "error",
      { "max": 60, "skipBlankLines": true, "skipComments": true }
    ],
    "max-params": ["error", { "max": 4 }],
    "max-depth": ["error", { "max": 4 }],
    "max-nested-callbacks": ["error", { "max": 3 }],
    // Restriction-tier and effectively repo-wide once any array or object is a
    // parameter; the codebase marks its own public shapes readonly instead.
    "typescript/prefer-readonly-parameter-types": "off",
    // Contradicts switch-exhaustiveness-check (kept on): a switch that covers
    // every member of a narrowed union needs no trailing return, and adding one
    // would hide a genuinely missing case from the compiler.
    "typescript/consistent-return": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "no-console": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/test/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-console": "off",
        // Test doubles stub only the slice of an interface under test, which
        // needs assertions the production code never does.
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/strict-void-return": "off",
        // A `describe` block is a grouping construct, not a unit of logic, so
        // its line count measures nothing. File size (max-lines) and parameter
        // counts stay enforced here.
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["packages/node/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Maintenance CLIs: plain ESM, outside the typed build, and printing is the
      // whole point of running them. The type-aware rules have nothing to work
      // from in a file no tsconfig includes — every `fetch` result reads as
      // `any` — so those are off here and the rest of the rule set still applies.
      "files": ["**/scripts/**/*.mjs"],
      "rules": {
        "no-console": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      // These walk the vendored OpenAPI document — someone else's JSON, with no
      // types to hand and no value in inventing any: the whole point is to read
      // what the document says rather than what we expected it to say.
      "files": [
        "packages/ofrep/test/openapi-document.ts",
        "packages/ofrep/test/spec-conformance.test.ts",
        "packages/ofrep/test/spec-operations.test.ts",
        "packages/ofrep/test/spec-examples.test.ts"
      ],
      "rules": {
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}
