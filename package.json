{
  "name": "kurenwimpel",
  "version": "0.0.0",
  "private": true,
  "description": "A simple feature flag solution",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf node_modules/.cache .turbo",
    "test": "turbo run test",
    "test:mutation": "turbo run test:mutation --concurrency=1",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run build && oxlint --type-aware --max-warnings=0",
    "lint:fix": "turbo run build && oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint:quick": "oxlint --max-warnings=0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.23.0"
}
